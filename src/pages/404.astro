---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout
  title="404 — Signal Lost"
  description="Page not found."
>
  <main class="min-h-screen flex items-center justify-center">
    <div class="container text-center">
      <p class="text-[0.8rem] font-mono tracking-[0.2em] uppercase text-accent mb-4">
        — 404 —
      </p>

      <h1 class="text-[clamp(5rem,18vw,12rem)] font-bold leading-none tracking-[-0.04em] text-primary/10 select-none mb-0">
        404
      </h1>

      <p class="text-[clamp(1.2rem,2.5vw,1.6rem)] font-bold text-primary -mt-4 mb-3">
        Signal lost.
      </p>

      <p class="text-secondary text-[0.95rem] mb-10 max-w-sm mx-auto leading-relaxed">
        This route doesn't exist. The page may have moved or never existed.
      </p>

      <a
        href="/"
        class="inline-flex items-center gap-2 text-[0.85rem] font-mono tracking-[0.1em] uppercase border border-border px-6 py-3 rounded-full text-secondary hover:text-accent hover:border-accent transition-colors duration-200"
      >
        ← Return to base
      </a>
    </div>
  </main>
</Layout>
