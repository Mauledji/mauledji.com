---
import "../styles/global.css";
import CustomCursor from "../components/layout/CustomCursor";
import TimelineNav from "../components/layout/TimelineNav";
import ToastProvider from "../components/layout/ToastProvider";
import type { Language } from "../lib/i18n/utils";

interface Props {
  lang?: Language;
  title?: string;
  description?: string;
  showNav?: boolean;
}

const {
  lang = "en",
  title = "Mauricio Ledezma — Fullstack Software Engineer",
  description = "Fullstack Software Engineer from San José, Costa Rica. Building production-ready apps with Java, Spring Boot, React and TypeScript.",
  showNav = true,
} = Astro.props;

const siteUrl = "https://mauledji.com";
const canonicalUrl = lang === "es" ? `${siteUrl}/es/` : `${siteUrl}/`;
const alternateEn = `${siteUrl}/`;
const alternateEs = `${siteUrl}/es/`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Mauricio Ledezma Jiménez" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="Fullstack Software Engineer from San José, Costa Rica. Building production-ready apps with Java, Spring Boot, React and TypeScript."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://mauledji.com" />
    <meta property="og:image" content="/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Mauricio Ledezma — Fullstack Software Engineer"
    />
    <meta
      name="twitter:description"
      content="Fullstack Software Engineer from San José, Costa Rica."
    />
    <meta name="twitter:image" content="/og-image.png" />

    <!-- Canonical + hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="es" href={alternateEs} />
    <link rel="alternate" hreflang="x-default" href={alternateEn} />

    <meta name="google-site-verification" content="LU5nqjTRu3EsLa9_ofuC-CAjN6BC5aC4YUqTgbybWxw" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-QYC7SD3F49"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-QYC7SD3F49');
    </script>
  </head>
  <body>
    <!-- Canvas de campo de estrellas -->
    <canvas id="starfield" aria-hidden="true"></canvas>

    <!-- Nebulosas decorativas -->
    <div class="nebula nebula-1" aria-hidden="true"></div>
    <div class="nebula nebula-2" aria-hidden="true"></div>
    <div class="nebula nebula-3" aria-hidden="true"></div>

    <CustomCursor client:only="react" />
    {showNav && <TimelineNav client:only="react" lang={lang} />}

    <!-- Language toggle — top right -->
    <div
      style="position:fixed;top:1.5rem;right:1.5rem;z-index:60;display:flex;align-items:center;gap:0.5rem;font-family:'JetBrains Mono',monospace;font-size:0.7rem;font-weight:600;letter-spacing:0.1em;"
    >
      <a
        href="/"
        style={`color:${lang === "en" ? "#a78bfa" : "rgba(255,255,255,0.35)"};text-decoration:none;transition:color 0.2s;`}
        >EN</a
      >
      <span style="color:rgba(255,255,255,0.15);">|</span>
      <a
        href="/es/"
        style={`color:${lang === "es" ? "#a78bfa" : "rgba(255,255,255,0.35)"};text-decoration:none;transition:color 0.2s;`}
        >ES</a
      >
    </div>
    <ToastProvider client:only="react" />

    <slot />

    <script>
      // =============================================
      // Campo de estrellas — canvas
      // =============================================
      const canvas = document.getElementById("starfield") as HTMLCanvasElement;
      if (canvas) {
        const ctx = canvas.getContext("2d")!;

        interface Star {
          x: number;
          y: number;
          size: number;
          opacity: number;
          twinkleSpeed: number;
          twinkleOffset: number;
        }

        let stars: Star[] = [];
        let width = window.innerWidth;
        let height = window.innerHeight;
        let animFrame: number;

        // ---- Shooting stars ----
        interface ShootingStar {
          x: number;
          y: number;
          vx: number;
          vy: number;
          length: number;
          opacity: number;
          fade: number; // 'in' phase speed
          life: number; // 0→1→0
          maxOpacity: number;
        }

        let shootingStars: ShootingStar[] = [];

        function spawnShootingStar() {
          // Start from a random point along the top or left edge
          const fromTop = Math.random() > 0.4;
          const x = fromTop ? Math.random() * width : 0;
          const y = fromTop ? 0 : Math.random() * height * 0.5;

          // Angle: mostly diagonal (30–60 degrees below horizontal)
          const angle = (Math.random() * 30 + 25) * (Math.PI / 180);
          const speed = Math.random() * 6 + 8;

          shootingStars.push({
            x,
            y,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            length: Math.random() * 120 + 80,
            opacity: 0,
            fade: Math.random() * 0.02 + 0.015,
            life: 0, // 0=fade in, peaks at 0.3, fades out to 1
            maxOpacity: Math.random() * 0.55 + 0.35,
          });
        }

        // Schedule next shooting star: every 3–9 seconds
        function scheduleNext() {
          const delay = Math.random() * 2000 + 1000;
          setTimeout(() => {
            spawnShootingStar();
            scheduleNext();
          }, delay);
        }

        function resize() {
          width = canvas.offsetWidth;
          height = canvas.offsetHeight;
          canvas.width = width;
          canvas.height = height;
        }

        function createStars(count: number) {
          stars = [];
          for (let i = 0; i < count; i++) {
            stars.push({
              x: Math.random() * width,
              y: Math.random() * height,
              size: Math.random() * 1.5 + 0.2,
              opacity: Math.random() * 0.7 + 0.1,
              twinkleSpeed: Math.random() * 0.02 + 0.005,
              twinkleOffset: Math.random() * Math.PI * 2,
            });
          }
        }

        let time = 0;
        function draw() {
          ctx.clearRect(0, 0, width, height);
          time += 0.01;

          // Regular stars
          for (const star of stars) {
            const twinkle =
              Math.sin(time * (star.twinkleSpeed * 100) + star.twinkleOffset) *
                0.3 +
              0.7;
            ctx.beginPath();
            ctx.arc(star.x, star.y, star.size, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(248, 250, 252, ${star.opacity * twinkle})`;
            ctx.fill();
          }

          // Shooting stars
          shootingStars = shootingStars.filter(
            (s) => s.opacity >= 0 || s.life < 0.4,
          );
          for (const s of shootingStars) {
            // Life drives fade in/out: ramp up to 0.35, hold, ramp down
            s.life += s.fade;
            if (s.life < 0.35) {
              s.opacity = (s.life / 0.35) * s.maxOpacity;
            } else {
              s.opacity = s.maxOpacity * (1 - (s.life - 0.35) / 0.65);
            }

            s.x += s.vx;
            s.y += s.vy;

            if (s.opacity <= 0 && s.life > 0.35) continue;

            // Draw trail as gradient line
            const tailX = s.x - s.vx * (s.length / Math.hypot(s.vx, s.vy));
            const tailY = s.y - s.vy * (s.length / Math.hypot(s.vx, s.vy));

            const grad = ctx.createLinearGradient(tailX, tailY, s.x, s.y);
            grad.addColorStop(0, `rgba(255,255,255,0)`);
            grad.addColorStop(0.7, `rgba(200,200,255,${s.opacity * 0.4})`);
            grad.addColorStop(1, `rgba(255,255,255,${Math.max(s.opacity, 0)})`);

            ctx.beginPath();
            ctx.moveTo(tailX, tailY);
            ctx.lineTo(s.x, s.y);
            ctx.strokeStyle = grad;
            ctx.lineWidth = 1.2;
            ctx.stroke();

            // Bright head dot
            ctx.beginPath();
            ctx.arc(s.x, s.y, 1.5, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(255,255,255,${Math.max(s.opacity, 0)})`;
            ctx.fill();
          }

          // Remove dead ones
          shootingStars = shootingStars.filter((s) => s.life < 1);

          animFrame = requestAnimationFrame(draw);
        }

        resize();
        createStars(220);
        draw();
        scheduleNext();

        const handleResize = () => {
          cancelAnimationFrame(animFrame);
          resize();
          createStars(220);
          draw();
        };

        window.addEventListener("resize", handleResize);

        // iOS Safari: visualViewport cambia cuando aparece/desaparece la barra del navegador
        if (window.visualViewport) {
          window.visualViewport.addEventListener("resize", handleResize);
        }
      }

      import { initAnimations } from "../lib/animations.ts";
      document.addEventListener("DOMContentLoaded", initAnimations);
    </script>
  </body>
</html>
