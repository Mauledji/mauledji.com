---
import "../styles/global.css";
import CustomCursor from "../components/layout/CustomCursor";
import TimelineNav from "../components/layout/TimelineNav";
import ToastProvider from "../components/layout/ToastProvider";
import type { Language } from "../lib/i18n/utils";

interface Props {
  lang?: Language;
  title?: string;
  description?: string;
  showNav?: boolean;
}

const {
  lang = "en",
  title = "Mauricio Ledezma — Fullstack Software Engineer",
  description = "Fullstack Software Engineer from San José, Costa Rica. Building production-ready apps with Java, Spring Boot, React and TypeScript.",
  showNav = true,
} = Astro.props;

const siteUrl = "https://mauledji.com";
const canonicalUrl = lang === "es" ? `${siteUrl}/es/` : `${siteUrl}/`;
const alternateEn = `${siteUrl}/`;
const alternateEs = `${siteUrl}/es/`;

// CSS starfield para móvil — generado en build time
function genStarLayer(count: number, spread: string, minOp: number, maxOp: number): string {
  return Array.from({ length: count }, () => {
    const x = Math.floor(Math.random() * 1000);
    const y = Math.floor(Math.random() * 1000);
    const op = (Math.random() * (maxOp - minOp) + minOp).toFixed(2);
    return `${x}px ${y}px 0 ${spread} rgba(248,250,252,${op})`;
  }).join(",");
}
const cssStars1 = genStarLayer(160, "0px",   0.12, 0.45); // tiny, dim
const cssStars2 = genStarLayer(75,  "0.5px", 0.30, 0.70); // medium
const cssStars3 = genStarLayer(28,  "1px",   0.60, 1.00); // bright, rare
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Mauricio Ledezma Jiménez" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="Fullstack Software Engineer from San José, Costa Rica. Building production-ready apps with Java, Spring Boot, React and TypeScript."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://mauledji.com" />
    <meta property="og:image" content="/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Mauricio Ledezma — Fullstack Software Engineer"
    />
    <meta
      name="twitter:description"
      content="Fullstack Software Engineer from San José, Costa Rica."
    />
    <meta name="twitter:image" content="/og-image.png" />

    <!-- Canonical + hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="es" href={alternateEs} />
    <link rel="alternate" hreflang="x-default" href={alternateEn} />

    <meta name="google-site-verification" content="LU5nqjTRu3EsLa9_ofuC-CAjN6BC5aC4YUqTgbybWxw" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-QYC7SD3F49"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-QYC7SD3F49');
    </script>
  </head>
  <body>
    <!-- Campo de estrellas WebGL (Three.js, carga en diferido) — desktop -->
    <canvas id="starfield" aria-hidden="true"></canvas>

    <!-- CSS starfield — móvil (evita bugs de iOS con position:fixed + canvas) -->
    <div id="starfield-css" aria-hidden="true">
      <div class="sl sl1" style={`box-shadow:${cssStars1}`}></div>
      <div class="sl sl2" style={`box-shadow:${cssStars2}`}></div>
      <div class="sl sl3" style={`box-shadow:${cssStars3}`}></div>
    </div>

    <CustomCursor client:only="react" />
    {showNav && <TimelineNav client:only="react" lang={lang} />}

    <!-- Language toggle — top right -->
    <div
      style="position:fixed;top:1.5rem;right:1.5rem;z-index:60;display:flex;align-items:center;gap:0.5rem;font-family:'JetBrains Mono',monospace;font-size:0.7rem;font-weight:600;letter-spacing:0.1em;"
    >
      <a
        href="/"
        style={`color:${lang === "en" ? "#a78bfa" : "rgba(255,255,255,0.35)"};text-decoration:none;transition:color 0.2s;`}
        >EN</a
      >
      <span style="color:rgba(255,255,255,0.15);">|</span>
      <a
        href="/es/"
        style={`color:${lang === "es" ? "#a78bfa" : "rgba(255,255,255,0.35)"};text-decoration:none;transition:color 0.2s;`}
        >ES</a
      >
    </div>
    <ToastProvider client:only="react" />

    <slot />

    <script>
      // Todo el motion (GSAP, Lenis y el starfield WebGL en diferido) vive en
      // src/lib/motion — un solo entry point con matchMedia para responsive y
      // reduced-motion.
      import { initMotion } from "../lib/motion";
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initMotion);
      } else {
        initMotion();
      }
    </script>
  </body>
</html>
