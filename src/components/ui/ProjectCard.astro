---
import ProjectCarousel from "./ProjectCarousel";

interface Props {
  number: string;
  name: string;
  subtitle: string;
  period: string;
  description: string;
  tech: string[];
  status: "production" | "completed";
  statusLabel: string;
  siteUrl?: string;
  githubUrl?: string;
  viewSiteLabel: string;
  images: [string, string];
}

const {
  number,
  name,
  subtitle,
  period,
  description,
  tech,
  statusLabel,
  siteUrl,
  githubUrl,
  viewSiteLabel,
  images,
} = Astro.props;
---

<article
  class="project-card glass border border-border/50 rounded-2xl overflow-hidden transition-[border-color] duration-300 relative hover:border-accent/35"
  data-animate="section"
>
  <div class="p-8 lg:p-10">
    <!-- Header -->
    <div class="flex items-center justify-between flex-wrap gap-4 mb-8 pb-6 border-b border-border" data-animate="item">
      <div class="flex items-baseline gap-2">
        <span class="text-[0.65rem] text-dim tracking-[0.2em] uppercase font-mono">MISSION</span>
        <span class="text-[1.8rem] font-bold text-accent font-mono leading-none">{number}</span>
      </div>
      <div class="flex items-center gap-5">
        <span class="inline-flex items-center gap-1.5 text-[0.72rem] text-secondary tracking-[0.08em] uppercase">
          <span class="status-dot w-1.5 h-1.5 rounded-full bg-green [box-shadow:0_0_6px_#22c55e]"></span>
          {statusLabel}
        </span>
        <span class="text-[0.72rem] text-subtle font-mono">{period}</span>
      </div>
    </div>

    <!-- 50/50: texto | carrusel -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-center">

      <!-- Texto -->
      <div class="flex flex-col gap-5">
        <div>
          <h3 class="text-[clamp(1.4rem,2.5vw,1.9rem)] font-bold text-primary tracking-[-0.02em] mb-1.5" data-animate="item">
            {name}
          </h3>
          <p class="text-sm text-muted" data-animate="item">{subtitle}</p>
        </div>

        <p class="text-secondary text-[0.95rem] leading-[1.8]" data-animate="item">
          {description}
        </p>

        <div class="flex flex-wrap gap-1.5" data-animate="item">
          {tech.map((tag) => <span class="tech-tag">{tag}</span>)}
        </div>

        <div class="flex gap-3 flex-wrap" data-animate="item">
          {siteUrl && (
            <a
              href={siteUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md text-[0.85rem] font-medium no-underline bg-accent text-star-white transition-[background,transform] duration-200 hover:bg-[#6d28d9] hover:-translate-y-0.5"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                <polyline points="15 3 21 3 21 9" />
                <line x1="10" y1="14" x2="21" y2="3" />
              </svg>
              {viewSiteLabel}
            </a>
          )}
          {githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md text-[0.85rem] font-medium no-underline border border-border text-secondary bg-surface/60 transition-all duration-200 hover:border-accent-light hover:text-accent-light hover:-translate-y-0.5"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
              GitHub
            </a>
          )}
        </div>
      </div>

      <!-- Carrusel React -->
      <div data-animate="item">
        <ProjectCarousel images={images} name={name} client:load />
      </div>

    </div>
  </div>
</article>

<style>
  .project-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at top left, rgba(124, 58, 237, 0.05), transparent 60%);
    pointer-events: none;
  }

  .status-dot {
    animation: blink 2s ease-in-out infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
</style>
