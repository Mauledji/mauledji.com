---
interface Props {
  title: string;
  issuer: string;
  date: string;
  credly: string;
}

const { title, issuer, date, credly } = Astro.props;
---

<div
  class="flex gap-3.5 items-start glass border border-border/50 rounded-[10px] p-4 transition-[border-color,transform] duration-200 ease-out hover:border-accent/30 hover:translate-x-1"
  data-animate="item"
>
  <div
    class="w-8 h-8 flex items-center justify-center bg-accent/10 border border-accent/20 rounded-lg text-accent-light shrink-0"
    aria-hidden="true"
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <circle cx="12" cy="8" r="5"></circle>
      <path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"></path>
    </svg>
  </div>
  <div class="flex flex-col gap-0.5 min-w-0">
    <h4 class="text-[0.82rem] font-medium text-primary leading-[1.4]">
      {title}
    </h4>
    <span class="text-[0.75rem] text-accent-light">{issuer}</span>
    <span class="text-[0.68rem] text-dim font-mono">{date}</span>
    <a
      href={credly}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 mt-1 text-[0.68rem] text-dim no-underline tracking-[0.05em] transition-colors duration-200 hover:text-accent-light"
      aria-label={`View credential: ${title}`}
    >
      <svg
        width="11"
        height="11"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
        ></path><polyline points="15 3 21 3 21 9"></polyline><line
          x1="10"
          y1="14"
          x2="21"
          y2="3"></line>
      </svg>
      Credly
    </a>
  </div>
</div>
