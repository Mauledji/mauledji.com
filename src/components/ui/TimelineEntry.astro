---
type DotVariant = "work" | "edu" | "databricks";

interface Props {
  period: string;
  title: string;
  org: string;
  location?: string;
  description: string;
  highlights?: string[];
  badge?: string;
  dot: DotVariant;
}

const { period, title, org, location, description, highlights, badge, dot } =
  Astro.props;

const dotClass: Record<DotVariant, string> = {
  work: "bg-accent [box-shadow:0_0_8px_rgba(124,58,237,0.5)]",
  edu: "bg-transparent border-2 border-dashed border-blue-500 [box-shadow:0_0_6px_rgba(59,130,246,0.3)]",
  databricks:
    "bg-transparent border-2 border-dashed border-yellow-400 [box-shadow:0_0_6px_rgba(245,158,11,0.3)]",
};
---

<div class="grid grid-cols-[24px_1fr] gap-4" data-animate="item">
  <div class="flex flex-col items-center pt-1">
    <div
      class={`w-2.5 h-2.5 rounded-full shrink-0 relative z-1 ${dotClass[dot]}`}
    >
    </div>
    <div
      class="flex-1 w-px bg-[linear-gradient(to_bottom,#1e1e2e,transparent)] mt-1.5 min-h-full"
    >
    </div>
  </div>

  <div class="pb-10">
    <div class="text-[0.72rem] text-dim font-mono tracking-[0.08em] mb-2">
      {period}
    </div>
    <div class="mb-3">
      <h4
        class="text-[1.05rem] font-semibold text-primary mb-1 tracking-[-0.01em] flex items-center gap-2 flex-wrap"
      >
        {title}
        {
          badge && (
            <span class="text-[0.65rem] text-yellow-400 bg-yellow-400/10 border border-yellow-400/30 px-2 py-0.5 rounded-full tracking-[0.06em] font-medium uppercase">
              {badge}
            </span>
          )
        }
      </h4>
      <span class="block text-[0.85rem] text-accent-light mb-1 font-medium"
        >{org}</span
      >
      {
        location && (
          <span class="inline-flex items-center gap-1 text-[0.75rem] text-dim">
            <svg
              width="11"
              height="11"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            {location}
          </span>
        )
      }
    </div>
    <p class="text-sm text-secondary leading-[1.7] mb-3">{description}</p>
    {
      highlights && highlights.length > 0 && (
        <ul class="list-none flex flex-col gap-1.25">
          {highlights.map((h) => (
            <li class="flex gap-2 text-[0.82rem] text-muted leading-normal">
              <span class="text-accent shrink-0 font-bold" aria-hidden="true">
                ›
              </span>
              {h}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>
