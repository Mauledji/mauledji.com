---
import type { Language } from "../../lib/i18n/utils";
import { t } from "../../lib/i18n/utils";
import ChannelCard from "../ui/ChannelCard.astro";
import ContactForm from "./ContactForm";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const i18n = t(lang);
---

<section id="contact" class="pt-28">
  <div class="container">
    <div class="constellation-line" data-animate="section">
      <span>{i18n.contact.section_label}</span>
    </div>

    <div
      class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center"
      data-animate="section"
    >
      <!-- Izquierda -->
      <div class="flex flex-col">
        <h2
          class="text-[clamp(2.5rem,5vw,3.5rem)] font-bold text-primary tracking-[-0.03em] leading-[1.1] mb-6 font-sans"
          data-animate="section"
        >
          {i18n.contact.title_line1}<br />
          <span class="text-accent-light">{i18n.contact.title_line2}</span>
        </h2>

        <p
          class="text-base text-secondary leading-[1.8] mb-10 max-w-110"
          data-animate="section"
        >
          {i18n.contact.subtitle}
        </p>

        <div class="flex flex-col gap-3" data-animate="section">
          <ChannelCard
            copy="mauledji@outlook.com"
            label={i18n.contact.channels.email}
            value="mauledji@outlook.com"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path
                d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
              ></path><polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </ChannelCard>

          <ChannelCard
            href="https://www.linkedin.com/in/mauledji/"
            label={i18n.contact.channels.linkedin}
            value="linkedin.com/in/mauledji"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
          </ChannelCard>

          <ChannelCard
            href="https://github.com/Mauledji"
            label={i18n.contact.channels.github}
            value="github.com/Mauledji"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
          </ChannelCard>

          <ChannelCard
            href={i18n.contact.channels.phone_href}
            target="_self"
            label={i18n.contact.channels.phone}
            value={i18n.contact.channels.phone_value}
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
              ></path>
            </svg>
          </ChannelCard>

          <ChannelCard
            href="/cv.pdf"
            label={i18n.contact.channels.cv}
            value="View CV"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path
                d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
              ></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </ChannelCard>
        </div>
      </div>

      <!-- Formulario de contacto -->
      <div data-animate="section" style="margin-top: 1.5rem;">
        <ContactForm client:load />
      </div>
    </div>
  </div>

  <div class="mt-24 pt-6 pb-6 border-t border-border">
    <div class="container">
      <div class="flex items-center justify-between flex-wrap gap-4">
        <span class="text-xs text-subtle font-mono"
          >© 2025 Mauricio Ledezma Jiménez</span
        >
        <span class="text-xs text-subtle font-mono"
          >Software Engineer · AI/ML & Data
        </span>
        <div class="flex items-center gap-1.5">
          <span
            class="footer-signal-dot w-1.25 h-1.25 bg-green rounded-full [box-shadow:0_0_4px_#22c55e]"
          ></span>
          <span class="text-xs text-subtle font-mono">SJO · CR</span>
        </div>
      </div>
    </div>
  </div>
</section>
